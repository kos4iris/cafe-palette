# Copy this file to backend/.env and paste your key. Never commit .env.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
# GEMINI_MODEL=gemini-3.5-flash-lite
# PORT=3001

# Google Search grounding is a billed tool. It is attempted by default and
# skipped automatically if unavailable. Set to "off" to skip it entirely.
# GEMINI_GROUNDING=off
